# Exact licensed CI typography assets must be ordinary Git blobs, not LFS pointers.
assets/fonts/AmiriQuran.ttf -filter -diff -merge -text
assets/fonts/Amiri-Regular.ttf -filter -diff -merge -text
assets/fonts/Amiri-Bold.ttf -filter -diff -merge -text
assets/fonts/NotoSans-Regular.ttf -filter -diff -merge -text
# Preserve the exact upstream OFL bytes, including their original whitespace.
assets/fonts/OFL-Amiri.txt whitespace=-blank-at-eol,-blank-at-eof

# Enforce Unix line endings for shell scripts and Python
*.sh text eol=lf
*.py text eol=lf
*.html -text whitespace=cr-at-eol
*.js -text whitespace=cr-at-eol
requirements.txt -text whitespace=cr-at-eol
*.ps1 text eol=crlf

# The bilingual companion verifies the raw bytes of its English parent.
data/alignments/**/*.json text eol=lf
