# Quran Reels Dashboard Environment Configuration
# Copy to .env.local for local dashboard development

# Admin Authentication (bcrypt hash of dashboard password)
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Backblaze B2 Storage (S3-Compatible Private Bucket)
B2_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
B2_REGION=eu-central-003
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
B2_PREFIX=quran-reels/

# GitHub Actions Dispatch
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_WORKFLOW_ID=generate-reel.yml
GITHUB_WORKFLOW_REF=main
GITHUB_ACTIONS_TOKEN=

# Server-only bearer for GET /api/cron/publishing-scheduler. Match Vault cron_secret.
CRON_SECRET=
# Server-only bearer for POST /api/scheduler/tick.
SCHEDULER_SECRET=
SCHEDULER_ACTIVE=false

# Pure Engine & Publishing Settings (Mirrored for System Status)
RECITER_REUSE_CONFIRMED=false
QF_CLIENT_ID=
QF_CLIENT_SECRET=
QF_ENV=prelive
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Local Mac only. Keep false/absent on Vercel and GitHub Actions.
LOCAL_BACKGROUND_POOL_BUILDER_ENABLED=false
META_APP_ID=
META_APP_SECRET=
# Preferred for a Business-type app using Facebook Login for Business.
META_LOGIN_CONFIG_ID=
# Base64-encoded 32-byte AES key; configure the identical value in GitHub Actions.
META_CREDENTIAL_ENCRYPTION_KEY=
# Optional fixed public origin; localhost/request origin is used when omitted.
META_REDIRECT_ORIGIN=
# Required only if the connected Meta user manages multiple Pages.
META_TARGET_PAGE_ID=
# Server-side state for a deployment you administer.
STATE_AUTHORITY=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The Buffer API key belongs to the Worker. The Dashboard only needs channel
# readiness settings and its own credentials for private media streaming.
PUBLISHER_BACKEND=buffer
BUFFER_ORGANIZATION_ID=
BUFFER_FACEBOOK_CHANNEL_ID=
BUFFER_INSTAGRAM_CHANNEL_ID=
BUFFER_PUBLISHING_ENABLED=false
BUFFER_FACEBOOK_ENABLED=false
BUFFER_INSTAGRAM_ENABLED=false
PUBLIC_MEDIA_DELIVERY_ORIGIN=
